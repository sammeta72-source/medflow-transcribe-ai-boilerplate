# ──────────────────────────────────────────────────────────────────────────────
# MedFlow Transcribe AI — Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — no server needed)
DATABASE_URL="file:./db/custom.db"
# PostgreSQL (for production)
# DATABASE_URL="postgresql://user:password@localhost:5432/medflow?schema=public"
# MySQL (alternative)
# DATABASE_URL="mysql://user:password@localhost:3306/medflow"

# ── Authentication ───────────────────────────────────────────────────────────
# Generate a random 32+ character string: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-32-char-string"
NEXTAUTH_URL="http://localhost:3000"

# ── FastAPI Backend (AI Agents Service) ──────────────────────────────────────
# The FastAPI service runs on port 8000 (internal)
# The Caddy gateway forwards /api/*?XTransformPort=8000 to this service
FASTAPI_URL="http://localhost:8000"
FASTAPI_PORT=8000

# ── AI Providers (for real AI — currently uses simulated/mock responses) ────
# OpenAI (for LLM + Whisper speech-to-text)
OPENAI_API_KEY=""
# Azure OpenAI (alternative)
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
# Speech-to-text provider
SPEECH_TO_TEXT_PROVIDER="openai"  # openai | azure | deepgram | whisper-local
# z-ai-web-dev-sdk (for the voice chatbot + live dictation — already installed)
ZAI_API_KEY=""

# ── Stripe Billing ────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Stripe product/price IDs for the 3 tiers
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PROFESSIONAL=""
STRIPE_PRICE_ENTERPRISE=""

# ── Email/Notifications ──────────────────────────────────────────────────────
EMAIL_PROVIDER_API_KEY=""  # SendGrid, Postmark, AWS SES, etc.
SUPPORT_EMAIL="support@medflow.ai"

# ── Object Storage (for audio files — S3-compatible) ────────────────────────
S3_ENDPOINT=""              # e.g., https://s3.amazonaws.com
S3_REGION="us-east-1"
S3_BUCKET="medflow-audio"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# For local dev, use MinIO: http://localhost:9000

# ── Encryption ────────────────────────────────────────────────────────────────
# For field-level encryption (AES-256-GCM)
ENCRYPTION_KEY=""  # 32-byte hex string: openssl rand -hex 32

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=""               # Error tracking
LOG_LEVEL="info"            # debug | info | warn | error

# ── Application ──────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
DEFAULT_TIMEZONE="America/New_York"
NODE_ENV="development"

# ── Caddy Gateway (for the XTransformPort proxy mechanism) ───────────────────
# The Caddyfile routes /api/*?XTransformPort=PORT to localhost:PORT
# This allows the Next.js frontend to reach the FastAPI backend via relative paths
GATEWAY_PORT=81
